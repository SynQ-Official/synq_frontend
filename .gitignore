# ==========================================
# SynQ Frontend — Git Ignore Configuration
# ==========================================

# 1. Dependencies & Package Managers
/node_modules
/package-lock.json
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions


# 2. Build & Export Outputs
/.next/
/out/
/build/
/dist/

# 3. Environment & Secret Files
.env*
!.env.example
!.env.sample

# 4. Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# 5. Testing & Code Quality
/coverage/

# 6. TypeScript Cache & Generated Types
*.tsbuildinfo
next-env.d.ts

# 7. Deployment Platforms
.vercel

# 8. OS & Editor Specific Files
.DS_Store
*.pem
.idea/
.vscode/

# 9. Local AI Caches & Local Directories
/doc
.claude/
.kilo/

# Large product films: hosted on R2, never committed (web encodes live in public/media/web/)
public/media/*.mp4
public/media/web/

# Ambient sound files live in ../ambiances-src (outside this repo); never commit them if copied in by mistake
ambiances-src/**/*.m4a
ambiances-src/**/*.opus
ambiances-src/**/*.wav

# 10. Markdown Documents (keep the root README)
*.md
!/README.md
!/scripts/ambiances/LICENCES.md

# Do NOT Ignore (Critical Config & Guidelines Files)
CLAUDE.md
AGENTS.md
.claudeignore